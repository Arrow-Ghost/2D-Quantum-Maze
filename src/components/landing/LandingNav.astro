---
// LandingNav.astro - Minimal Sticky Laboratory Navigation Bar
---

<header class="landing-header">
  <div class="landing-nav-inner">
    <!-- Brand -->
    <div class="landing-brand">
      <a href="/" class="brand-link">
        <div class="brand-quantum-glyph">Ψ</div>
        <div class="brand-text-block">
          <span class="brand-title">QUANTUM MAZE</span>
          <span class="brand-meta">EXPERIMENT PORTAL</span>
        </div>
      </a>
    </div>

    <!-- Center Navigation Links -->
    <nav class="landing-nav-menu">
      <a href="/levels" class="landing-nav-link">
        <span class="nav-icon">◈</span> Levels
      </a>
      <a href="/lab" class="landing-nav-link">
        <span class="nav-icon">⚗</span> Quantum Lab
      </a>
      <a href="/tutorial" class="landing-nav-link">
        <span class="nav-icon">📖</span> Guide
      </a>
      <a href="/leaderboard" class="landing-nav-link">
        <span class="nav-icon">🏆</span> Records
      </a>
      <a href="/settings" class="landing-nav-link">
        <span class="nav-icon">⚙</span> Settings
      </a>
    </nav>

    <!-- Right Status & CTA -->
    <div class="landing-nav-actions">
      <div class="backend-active-pill" id="landingBackendStatus">
        <span class="pill-dot"></span>
        <span class="pill-text">QISKIT ENGINE ACTIVE</span>
      </div>

      <a href="/game?level=level-01" class="btn-quantum nav-cta-start">
        <span>⚡ START EXPERIMENT</span>
      </a>
    </div>
  </div>

  <!-- Scroll Progress Indicator Line -->
  <div class="nav-progress-track">
    <div class="nav-progress-fill" id="hudScrollProgress" style="width: 0%;"></div>
  </div>
</header>

<style>
  .landing-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(6, 9, 14, 0.88);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .landing-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 28px;
    max-width: 1360px;
    margin: 0 auto;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand-quantum-glyph {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(0, 240, 255, 0.2), rgba(123, 44, 191, 0.3));
    border: 1px solid var(--quantum-cyan);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 800;
    color: var(--quantum-cyan);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
  }

  .brand-text-block {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #f8fafc;
  }

  .brand-meta {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    color: var(--quantum-cyan);
  }

  .landing-nav-menu {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .landing-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .landing-nav-link:hover {
    color: #f1f5f9;
    background: rgba(255, 255, 255, 0.05);
  }

  .landing-nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .backend-active-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    background: rgba(0, 245, 155, 0.08);
    border: 1px solid rgba(0, 245, 155, 0.3);
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--quantum-emerald);
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--quantum-emerald);
    box-shadow: 0 0 8px var(--quantum-emerald);
  }

  .nav-cta-start {
    padding: 8px 18px;
    font-size: 12px;
  }

  .nav-progress-track {
    width: 100%;
    height: 2px;
    background: rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }

  .nav-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #00f0ff, #00f59b, #c77dff);
    transition: width 0.1s linear;
  }

  @media (max-width: 990px) {
    .landing-nav-menu, .backend-active-pill {
      display: none;
    }
  }
</style>
