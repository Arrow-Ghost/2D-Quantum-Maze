---
// PauseMenu Component
---

<div id="pauseMenuModal" class="modal-overlay" style="display: none;">
  <div class="modal-card" style="text-align: center; max-width: 400px;">
    <h2 style="font-family: var(--font-display); font-size: 24px; color: #ffffff; margin-bottom: 4px;">
      SIMULATION PAUSED
    </h2>
    <p style="font-size: 13px; color: #94a3b8; font-family: var(--font-mono); margin-bottom: 16px;">
      Quantum statevector preserved in memory.
    </p>

    <div style="display: flex; flex-direction: column; gap: 10px;">
      <button id="btnResume" class="btn-quantum" style="width: 100%;">
        Resume Simulation [ESC]
      </button>
      <button id="btnRestartLevel" class="btn-quantum-secondary" style="width: 100%;">
        Restart Sector
      </button>
      <a href="/levels" class="btn-quantum-secondary" style="width: 100%; text-align: center;">
        Sector Select
      </a>
      <a href="/settings" class="btn-quantum-secondary" style="width: 100%; text-align: center;">
        Audio & Visual Settings
      </a>
      <a href="/" class="btn-quantum-secondary" style="width: 100%; text-align: center;">
        Main Menu
      </a>
    </div>
  </div>
</div>
