---
import InteractionModal from '../components/InteractionModal.astro';
import PauseMenu from '../components/PauseMenu.astro';
import VictoryModal from '../components/VictoryModal.astro';
import FailureModal from '../components/FailureModal.astro';
import DebugPanel from '../components/DebugPanel.astro';
import '../styles/global.css';
import '../styles/themes.css';
import '../styles/game.css';
import '../styles/hud.css';
import '../styles/animations.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>QUANTUM MAZE</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline>
    try {
      var t = localStorage.getItem('qm_theme');
      if (t) document.documentElement.dataset.theme = t;
    } catch (e) {}
    // Touch devices get on-screen controls; set before first paint to avoid a layout jump.
    if (window.matchMedia && matchMedia('(pointer: coarse)').matches) document.documentElement.classList.add('touch');
  </script>
</head>
<body class="game-page">
  <div class="game-shell">
    <!-- Top bar: identity, objective, vitals. Wraps to two rows on narrow frames. -->
    <header class="topbar">
      <div class="topbar-left">
        <a href="/levels" class="topbar-back" title="Back to sectors" aria-label="Back to sectors">‹</a>
        <div class="topbar-id">
          <div class="topbar-sector">SECTOR <span id="hudLevelNumber">01</span></div>
          <div class="topbar-title" id="hudLevelTitle">Superposition</div>
        </div>
      </div>

      <div class="topbar-objective">
        <span class="topbar-objective-tag">OBJECTIVE</span>
        <span id="objectiveText">Reach the quantum checkpoint.</span>
      </div>

      <div class="topbar-right">
        <div class="vital vital-time"><span class="vital-k">TIME</span><span class="vital-v" id="hudTime">00:00.0</span></div>
        <div class="vital vital-moves"><span class="vital-k">MOVES</span><span class="vital-v" id="hudMoveCount">0</span></div>
        <div class="vital vital-energy">
          <span class="vital-k">ENERGY</span>
          <span class="energy-track"><span class="energy-fill" id="hudEnergyFill" style="width:100%"></span></span>
          <span class="vital-v" id="hudEnergyValue">100</span>
        </div>
        <button id="btnFullscreen" class="icon-btn" title="Fullscreen (F)" aria-label="Toggle fullscreen" hidden><svg class="ico" viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"/></svg></button>
        <button id="btnPause" class="icon-btn" title="Pause (Esc)" aria-label="Pause"><svg class="ico" viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><rect x="6" y="5" width="4" height="14" fill="currentColor"/><rect x="14" y="5" width="4" height="14" fill="currentColor"/></svg></button>
      </div>
    </header>

    <!-- Play area: board + side panel (a column in landscape, a strip below in portrait). -->
    <main class="play">
      <div class="board-area" id="boardArea">
        <canvas id="gameCanvas" aria-label="Maze board"></canvas>
        <div id="gameToast" class="message-toast toast-info" style="display:none;">Ready.</div>
        <button id="rotateHint" class="rotate-hint" type="button">Rotate for a bigger maze</button>
      </div>

      <aside class="qpanel" id="qpanel">
        <section class="qpanel-readout">
          <div class="qpanel-exit">
            <span class="qpanel-exit-k">EXIT</span>
            <span class="qpanel-exit-v" id="hudExitProb">50%</span>
            <span class="quantum-badge badge-amber" id="hudExitStatus">LOCKED</span>
          </div>
          <div class="qbar">
            <div class="qbar-head">
              <span id="qTargetLabel">q0 → |1⟩</span>
              <span id="qTargetPct">50%</span>
            </div>
            <div class="qbar-track"><div class="qbar-fill" id="qTargetFill" style="width:50%"></div></div>
            <div class="qbar-sub" id="quantumStatusLine">Superposition</div>
          </div>
        </section>

        <section class="qpanel-gates">
          <span class="qpanel-k">TERMINAL</span>
          <div class="gate-row" id="gateRow"></div>
          <div class="qpanel-foot">
            <span id="measRow">Measurements 0/3</span>
            <span id="terminalHint">Reach checkpoint to unlock</span>
          </div>
          <button id="btnOpenTerminalDirect" class="btn-quantum qpanel-open" disabled>OPEN TERMINAL</button>
        </section>

        <!-- On-screen D-pad (touch devices). Hold a direction to keep walking. -->
        <section class="dpad" id="dpad" aria-label="Movement controls">
          <button class="dpad-btn dpad-up" data-dir="UP" aria-label="Up"><svg class="ico" viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" transform="rotate(0 12 12)"/></svg></button>
          <button class="dpad-btn dpad-left" data-dir="LEFT" aria-label="Left"><svg class="ico" viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" transform="rotate(-90 12 12)"/></svg></button>
          <button class="dpad-btn dpad-mid" id="dpadAction" aria-label="Open terminal">E</button>
          <button class="dpad-btn dpad-right" data-dir="RIGHT" aria-label="Right"><svg class="ico" viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" transform="rotate(90 12 12)"/></svg></button>
          <button class="dpad-btn dpad-down" data-dir="DOWN" aria-label="Down"><svg class="ico" viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" transform="rotate(180 12 12)"/></svg></button>
        </section>

        <footer class="qpanel-bar">
          <div class="theme-dock" role="group" aria-label="Theme">
            <button class="theme-swatch" data-theme-btn="superposition" title="Superposition" aria-label="Superposition theme"></button>
            <button class="theme-swatch" data-theme-btn="entangled" title="Entangled" aria-label="Entangled theme"></button>
            <button class="theme-swatch" data-theme-btn="collapse" title="Collapse" aria-label="Collapse theme"></button>
            <button class="theme-swatch" data-theme-btn="phase" title="Phase" aria-label="Phase theme"></button>
            <button class="theme-swatch" data-theme-btn="ground" title="Ground State" aria-label="Ground State theme"></button>
          </div>
          <button id="btnHelp" class="icon-btn" title="Help (H)" aria-label="Help">?</button>
        </footer>
      </aside>
    </main>

    <div id="helpOverlay" class="help-overlay" style="display:none;">
      <div class="help-card">
        <div class="help-head">
          <span class="panel-title">How this sector works</span>
          <button id="btnCloseHelp" class="btn-quantum-secondary" style="padding:2px 10px;" aria-label="Close help"><svg class="ico" viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"/></svg></button>
        </div>
        <p class="help-controls">
          <b>Keyboard:</b> move WASD / arrows · terminal E · pause Esc · help H · fullscreen F<br />
          <b>Mouse / touch:</b> tap a square to step toward it, swipe, or use the D-pad
        </p>
        <p class="help-controls">Every step drains energy and reshuffles the maze. The exit readout fluctuates while the qubit is in superposition — it locks once you hit the target.</p>
        <p class="help-k">Objective</p>
        <p id="helpObjective" class="help-t"></p>
        <p class="help-k">The idea</p>
        <p id="helpConcept" class="help-t"></p>
        <p class="help-k">Hint</p>
        <p id="helpHint" class="help-t"></p>
      </div>
    </div>

    <InteractionModal />
    <PauseMenu />
    <VictoryModal />
    <FailureModal />
    <DebugPanel />
  </div>

  <script>
    import { GameEngine } from '../lib/game/gameEngine';
    import { MazeRenderer } from '../lib/game/renderer';
    import { LEVELS } from '../data/levels';

    const THEMES = ['superposition', 'entangled', 'collapse', 'phase', 'ground'];

    document.addEventListener('DOMContentLoaded', async () => {
      const urlParams = new URLSearchParams(window.location.search);
      const levelId = urlParams.get('level') || 'level-01';

      const canvas = document.getElementById('gameCanvas') as HTMLCanvasElement;
      if (!canvas) return;
      const renderer = new MazeRenderer(canvas);

      const $ = (id: string) => document.getElementById(id);
      const hudLevelNumber = $('hudLevelNumber');
      const hudLevelTitle = $('hudLevelTitle');
      const hudTime = $('hudTime');
      const hudMoveCount = $('hudMoveCount');
      const hudEnergyFill = $('hudEnergyFill');
      const hudEnergyValue = $('hudEnergyValue');
      const objectiveText = $('objectiveText');
      const hudExitProb = $('hudExitProb');
      const hudExitStatus = $('hudExitStatus');
      const qTargetLabel = $('qTargetLabel');
      const qTargetPct = $('qTargetPct');
      const qTargetFill = $('qTargetFill');
      const quantumStatusLine = $('quantumStatusLine');
      const gateRow = $('gateRow');
      const measRow = $('measRow');
      const terminalHint = $('terminalHint');
      const btnOpenTerminalDirect = $('btnOpenTerminalDirect') as HTMLButtonElement;
      const gameToast = $('gameToast');

      const interactionModal = $('interactionModal');
      const btnCloseInteractModal = $('btnCloseInteractModal');
      const btnCancelInteract = $('btnCancelInteract');
      const btnExecuteGate = $('btnExecuteGate');
      const selectTargetQubit = $('selectTargetQubit') as HTMLSelectElement;
      const selectControlQubit = $('selectControlQubit') as HTMLSelectElement;
      const controlQubitGroup = $('controlQubitGroup');
      const modalGateGrid = $('modalGateGrid');
      const selectedGateName = $('selectedGateName');
      const selectedGateCost = $('selectedGateCost');
      const selectedGateDesc = $('selectedGateDesc');

      const pauseMenuModal = $('pauseMenuModal');
      const btnPause = $('btnPause');
      const btnResume = $('btnResume');
      const btnRestartLevel = $('btnRestartLevel');

      const victoryModal = $('victoryModal');
      const victoryTotalScore = $('victoryTotalScore');
      const victoryTime = $('victoryTime');
      const victoryTimeBonus = $('victoryTimeBonus');
      const victoryGatesUsed = $('victoryGatesUsed');
      const victoryEfficiency = $('victoryEfficiency');
      const victoryProbability = $('victoryProbability');
      const victoryEnergy = $('victoryEnergy');
      const victoryStarsContainer = $('victoryStarsContainer');
      const btnNextLevel = $('btnNextLevel');
      const btnReplayLevel = $('btnReplayLevel');

      const failureModal = $('failureModal');
      const failureReasonText = $('failureReasonText');
      const btnRetryLevel = $('btnRetryLevel');

      const debugPanel = $('debugPanel');
      const btnCloseDebug = $('btnCloseDebug');
      const debugSessionId = $('debugSessionId');
      const debugPlayerPos = $('debugPlayerPos');
      const debugEnergy = $('debugEnergy');
      const debugMeasurements = $('debugMeasurements');
      const debugExitUnlocked = $('debugExitUnlocked');
      const debugExitReason = $('debugExitReason');
      const btnDebugAddEnergy = $('btnDebugAddEnergy');
      const btnDebugUnlockExit = $('btnDebugUnlockExit');

      const btnHelp = $('btnHelp');
      const btnCloseHelp = $('btnCloseHelp');
      const helpOverlay = $('helpOverlay');
      const helpObjective = $('helpObjective');
      const helpConcept = $('helpConcept');
      const helpHint = $('helpHint');

      const boardArea = $('boardArea');
      const btnFullscreen = $('btnFullscreen') as HTMLButtonElement;
      const dpadAction = $('dpadAction');
      const rotateHint = $('rotateHint');
      const isTouch = () => document.documentElement.classList.contains('touch');

      let selectedModalGate = 'H';
      let toastTimeout: number | null = null;

      function showToast(msg: string, type: 'info' | 'success' | 'warning' | 'error' = 'info') {
        if (!gameToast) return;
        gameToast.textContent = msg;
        gameToast.className = `message-toast toast-${type}`;
        gameToast.style.display = 'block';
        if (toastTimeout) clearTimeout(toastTimeout);
        toastTimeout = window.setTimeout(() => { gameToast.style.display = 'none'; }, 2800);
      }

      // ---- Theme switcher ----
      function applyTheme(name: string) {
        if (!THEMES.includes(name)) name = 'superposition';
        document.documentElement.dataset.theme = name;
        try { localStorage.setItem('qm_theme', name); } catch (e) {}
        document.querySelectorAll('[data-theme-btn]').forEach((b) => {
          b.classList.toggle('active', (b as HTMLElement).dataset.themeBtn === name);
        });
        renderer.refreshPalette();
      }
      document.querySelectorAll('[data-theme-btn]').forEach((b) => {
        b.addEventListener('click', () => applyTheme((b as HTMLElement).dataset.themeBtn || 'superposition'));
      });
      applyTheme(document.documentElement.dataset.theme || 'superposition');

      const engine = new GameEngine({
        onStateUpdate: (eng) => updateUI(eng),
        onWallTransition: () => {},
        onVictory: (report) => {
          if (!victoryModal) return;
          victoryModal.style.display = 'flex';
          if (victoryTotalScore) victoryTotalScore.textContent = report.totalScore.toString();
          if (victoryTime) victoryTime.textContent = fmtTime(report.elapsedTime);
          if (victoryTimeBonus) victoryTimeBonus.textContent = `+${report.timeBonus}`;
          if (victoryGatesUsed) victoryGatesUsed.textContent = report.gatesUsed.toString();
          if (victoryEfficiency) victoryEfficiency.textContent = `+${report.quantumEfficiency}`;
          if (victoryProbability) victoryProbability.textContent = `${Math.round(report.finalProbability * 100)}%`;
          if (victoryEnergy) victoryEnergy.textContent = `${report.energyRemaining} QE`;
          if (victoryStarsContainer) {
            victoryStarsContainer.innerHTML = [1, 2, 3]
              .map((s) => `<span style="color:${s <= report.stars ? 'var(--warn)' : 'var(--border-strong)'}"><svg class="ico" viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.5l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17.4l-6.1 3.5 1.5-6.8-5.2-4.6 6.9-.7z"/></svg></span>`)
              .join('');
          }
        },
        onFailure: (reason) => {
          if (!failureModal) return;
          failureModal.style.display = 'flex';
          if (failureReasonText) failureReasonText.textContent = reason;
        },
        onInteractPrompt: () => updateUI(engine),
        onMessage: (msg, type) => showToast(msg, type),
      });

      function fmtTime(s: number) {
        const m = Math.floor(s / 60);
        return `${m.toString().padStart(2, '0')}:${(s % 60).toFixed(1).padStart(4, '0')}`;
      }

      function updateUI(eng: GameEngine) {
        const lvl = eng.currentLevel;
        if (hudLevelNumber) hudLevelNumber.textContent = lvl.levelNumber.toString().padStart(2, '0');
        if (hudLevelTitle) hudLevelTitle.textContent = lvl.title;
        if (hudTime) hudTime.textContent = fmtTime(eng.elapsedTime);
        if (hudMoveCount) hudMoveCount.textContent = eng.movesUsed.toString();

        const energyPct = Math.max(0, Math.min(100, (eng.energy / lvl.initialEnergy) * 100));
        if (hudEnergyFill) {
          hudEnergyFill.style.width = `${energyPct}%`;
          hudEnergyFill.className = `energy-fill${energyPct < 25 ? ' low' : ''}`;
        }
        if (hudEnergyValue) hudEnergyValue.textContent = `${eng.energy}`;

        const allCp = eng.checkpoints.every((c) => c.activated);
        const nextCp = eng.checkpoints.find((c) => !c.activated);
        let obj: string;
        if (!allCp && nextCp) obj = `Reach ${nextCp.label}.`;
        else if (eng.exitUnlocked) obj = 'Exit portal is OPEN — walk onto it.';
        else obj = eng.exitValidationReason || 'Open the terminal and solve the quantum objective.';
        if (objectiveText) objectiveText.textContent = obj;

        const probPct = Math.round(eng.exitProbability * 100);
        if (hudExitProb) hudExitProb.textContent = `${probPct}%`;
        if (hudExitStatus) {
          hudExitStatus.textContent = eng.exitUnlocked ? 'OPEN' : 'LOCKED';
          hudExitStatus.className = `quantum-badge ${eng.exitUnlocked ? 'badge-emerald' : 'badge-amber'}`;
        }

        const tq = lvl.exitPosition.targetQubit;
        const reqState = lvl.exitPosition.requiredState;
        if (qTargetLabel) qTargetLabel.textContent = `q${tq} → |${reqState}⟩`;
        if (qTargetPct) qTargetPct.textContent = `${probPct}%`;
        if (qTargetFill) qTargetFill.style.width = `${probPct}%`;

        if (quantumStatusLine) {
          const qp = eng.stateInfo?.qubit_probabilities[tq];
          if (!qp) quantumStatusLine.textContent = '';
          else if (qp.collapsed_state !== null) quantumStatusLine.textContent = `q${tq} collapsed to |${qp.collapsed_state}⟩`;
          else if (qp.is_entangled) quantumStatusLine.textContent = `q${tq} entangled · ${Math.round(qp.p1 * 100)}% |1⟩`;
          else quantumStatusLine.textContent = `q${tq} superposition · ${Math.round(qp.p1 * 100)}% |1⟩`;
        }

        const unlocked = eng.terminals.some((t) => t.unlocked);
        if (measRow) measRow.textContent = `Measurements ${eng.measurementsUsed}/${lvl.measurementBudget}`;
        if (terminalHint) {
          terminalHint.textContent = !unlocked
            ? 'Reach checkpoint to unlock'
            : isTouch() ? 'Tap E or OPEN TERMINAL' : 'Press E to open terminal';
        }
        if (btnOpenTerminalDirect) btnOpenTerminalDirect.disabled = !unlocked;
        if (gateRow) {
          gateRow.querySelectorAll('button').forEach((b) => ((b as HTMLButtonElement).disabled = !unlocked));
        }

        if (debugSessionId) debugSessionId.textContent = eng.activeSessionId;
        if (debugPlayerPos) debugPlayerPos.textContent = `(r:${eng.player.r}, c:${eng.player.c})`;
        if (debugEnergy) debugEnergy.textContent = eng.energy.toString();
        if (debugMeasurements) debugMeasurements.textContent = `${eng.measurementsUsed}/${lvl.measurementBudget}`;
        if (debugExitUnlocked) debugExitUnlocked.textContent = eng.exitUnlocked ? 'TRUE' : 'FALSE';
        if (debugExitReason) debugExitReason.textContent = eng.exitValidationReason;
      }

      function gateCost(g: string) {
        const G = g.toUpperCase();
        if (G === 'CNOT' || G === 'CX') return 20;
        if (G === 'H') return 10;
        if (G === 'M') return 15;
        return 5;
      }

      function buildGateRow() {
        if (!gateRow) return;
        gateRow.innerHTML = '';
        engine.currentLevel.allowedGates.forEach((g) => {
          const btn = document.createElement('button');
          btn.className = 'gate-chip';
          btn.textContent = g === 'CNOT' ? 'CX' : g;
          btn.title = `${g} · ${gateCost(g)} QE`;
          btn.disabled = true;
          btn.addEventListener('click', () => {
            selectedModalGate = g;
            openInteractionModal();
          });
          gateRow.appendChild(btn);
        });
      }

      function openInteractionModal() {
        if (!interactionModal) return;
        const n = engine.currentLevel.numQubits;
        for (const sel of [selectTargetQubit, selectControlQubit]) {
          if (!sel) continue;
          sel.innerHTML = '';
          for (let q = 0; q < n; q++) {
            const o = document.createElement('option');
            o.value = q.toString();
            o.textContent = `q${q}`;
            sel.appendChild(o);
          }
        }
        if (selectControlQubit && selectControlQubit.options.length > 1) selectControlQubit.value = '0';
        if (selectTargetQubit && selectTargetQubit.options.length > 1) selectTargetQubit.value = '1';

        const allowed = engine.currentLevel.allowedGates;
        if (modalGateGrid) {
          modalGateGrid.innerHTML = allowed
            .map((g) => `
              <button class="gate-btn modal-gate-select ${g === selectedModalGate ? 'active-glow' : ''}" data-gate="${g}">
                <span class="gate-glyph">${g === 'CNOT' ? 'CX' : g}</span>
                <span class="gate-cost">${gateCost(g)} QE</span>
              </button>`)
            .join('');
          modalGateGrid.querySelectorAll('.modal-gate-select').forEach((b) => {
            b.addEventListener('click', (e) => {
              const el = e.currentTarget as HTMLElement;
              selectedModalGate = el.dataset.gate || 'H';
              modalGateGrid.querySelectorAll('.modal-gate-select').forEach((x) => x.classList.remove('active-glow'));
              el.classList.add('active-glow');
              updateModalGateDetails(selectedModalGate);
            });
          });
        }
        updateModalGateDetails(selectedModalGate);
        interactionModal.style.display = 'flex';
      }

      function updateModalGateDetails(gate: string) {
        const g = gate.toUpperCase();
        const isCnot = g === 'CNOT' || g === 'CX';
        if (controlQubitGroup) controlQubitGroup.style.display = isCnot ? 'block' : 'none';
        const names: Record<string, string> = {
          H: 'Hadamard (H)', X: 'Pauli-X (X)', Z: 'Pauli-Z (Z)', CNOT: 'Controlled-NOT', CX: 'Controlled-NOT', M: 'Measurement (M)',
        };
        const descs: Record<string, string> = {
          H: 'Puts a qubit into an equal superposition of |0⟩ and |1⟩.',
          X: 'Bit flip: swaps |0⟩ and |1⟩.',
          Z: 'Phase flip: negates |1⟩. No probability change on its own.',
          CNOT: 'Flips the target qubit when the control qubit is |1⟩. Creates entanglement.',
          CX: 'Flips the target qubit when the control qubit is |1⟩. Creates entanglement.',
          M: 'Collapses the qubit onto |0⟩ or |1⟩ at random (Born rule).',
        };
        if (selectedGateName) selectedGateName.textContent = names[g] || `${g} gate`;
        if (selectedGateCost) selectedGateCost.textContent = `${gateCost(g)} QE`;
        if (selectedGateDesc) selectedGateDesc.textContent = descs[g] || 'Quantum operation.';
      }

      function closeInteractionModal() {
        if (interactionModal) interactionModal.style.display = 'none';
      }

      btnExecuteGate?.addEventListener('click', async () => {
        const target = parseInt(selectTargetQubit?.value || '0', 10);
        const control = parseInt(selectControlQubit?.value || '0', 10);
        closeInteractionModal();
        const g = selectedModalGate.toUpperCase();
        if (g === 'M') await engine.performMeasurement(target);
        else if (g === 'CNOT' || g === 'CX') await engine.applyGate('CNOT', target, control);
        else await engine.applyGate(selectedModalGate, target);
      });

      btnCloseInteractModal?.addEventListener('click', closeInteractionModal);
      btnCancelInteract?.addEventListener('click', closeInteractionModal);
      btnOpenTerminalDirect?.addEventListener('click', () => {
        if (engine.terminals.some((t) => t.unlocked)) openInteractionModal();
        else showToast('Reach the checkpoint first.', 'warning');
      });

      btnPause?.addEventListener('click', () => {
        engine.pauseGame();
        if (pauseMenuModal) pauseMenuModal.style.display = 'flex';
      });
      btnResume?.addEventListener('click', () => {
        if (pauseMenuModal) pauseMenuModal.style.display = 'none';
        engine.resumeGame();
      });
      btnRestartLevel?.addEventListener('click', () => {
        if (pauseMenuModal) pauseMenuModal.style.display = 'none';
        engine.restartLevel();
      });
      btnRetryLevel?.addEventListener('click', () => {
        if (failureModal) failureModal.style.display = 'none';
        engine.restartLevel();
      });
      btnReplayLevel?.addEventListener('click', () => {
        if (victoryModal) victoryModal.style.display = 'none';
        engine.restartLevel();
      });
      btnNextLevel?.addEventListener('click', () => {
        if (victoryModal) victoryModal.style.display = 'none';
        const next = LEVELS.find((l) => l.levelNumber === engine.currentLevel.levelNumber + 1);
        window.location.href = next ? `/game?level=${next.id}` : '/levels';
      });

      btnCloseDebug?.addEventListener('click', () => { if (debugPanel) debugPanel.style.display = 'none'; });
      btnDebugAddEnergy?.addEventListener('click', () => { engine.energy += 50; showToast('Debug: +50 energy', 'info'); updateUI(engine); });
      btnDebugUnlockExit?.addEventListener('click', () => { engine.exitUnlocked = true; showToast('Debug: exit forced open', 'success'); updateUI(engine); });

      function toggleHelp(force?: boolean) {
        if (!helpOverlay) return;
        const show = force !== undefined ? force : helpOverlay.style.display === 'none';
        helpOverlay.style.display = show ? 'flex' : 'none';
        if (show) {
          if (helpObjective) helpObjective.textContent = engine.currentLevel.briefing;
          if (helpConcept) helpConcept.textContent = engine.currentLevel.quantumConcept;
          if (helpHint) helpHint.textContent = engine.currentLevel.hint || '';
        }
      }
      btnHelp?.addEventListener('click', () => toggleHelp());
      btnCloseHelp?.addEventListener('click', () => toggleHelp(false));

      // ---- Input: shared helpers ----
      type Dir = 'UP' | 'DOWN' | 'LEFT' | 'RIGHT';
      const shown = (el: HTMLElement | null) => !!el && el.style.display === 'flex';
      const overlayOpen = () =>
        [interactionModal, helpOverlay, pauseMenuModal, victoryModal, failureModal].some(shown);

      function tryMove(dir: Dir) {
        if (engine.status !== 'PLAYING' || overlayOpen()) return;
        engine.movePlayer(dir);
      }

      function openTerminal() {
        if (engine.status !== 'PLAYING' || overlayOpen()) return;
        if (engine.terminals.some((t) => t.unlocked)) openInteractionModal();
        else showToast('Reach the checkpoint to unlock the terminal.', 'warning');
      }

      // ---- Fullscreen (hidden where the host frame doesn't allow it) ----
      const doc = document as any;
      const canFullscreen = !!(document.fullscreenEnabled || doc.webkitFullscreenEnabled);
      if (btnFullscreen) btnFullscreen.hidden = !canFullscreen;
      function toggleFullscreen() {
        if (!canFullscreen) return;
        const active = document.fullscreenElement || doc.webkitFullscreenElement;
        if (active) (document.exitFullscreen || doc.webkitExitFullscreen)?.call(document);
        else {
          const el = document.documentElement as any;
          (el.requestFullscreen || el.webkitRequestFullscreen)?.call(el);
        }
      }
      btnFullscreen?.addEventListener('click', toggleFullscreen);

      // ---- Keyboard ----
      const KEY_DIRS: Record<string, Dir> = {
        w: 'UP', arrowup: 'UP', s: 'DOWN', arrowdown: 'DOWN',
        a: 'LEFT', arrowleft: 'LEFT', d: 'RIGHT', arrowright: 'RIGHT',
      };
      window.addEventListener('keydown', (e) => {
        // Let form controls in the terminal dialog handle their own keys.
        const tag = (e.target as HTMLElement)?.tagName;
        if (tag === 'SELECT' || tag === 'INPUT' || tag === 'TEXTAREA') {
          if (e.key === 'Escape') closeInteractionModal();
          return;
        }
        const key = e.key.toLowerCase();

        if (key === 'escape') {
          if (shown(interactionModal)) return closeInteractionModal();
          if (shown(helpOverlay)) return toggleHelp(false);
          if (shown(victoryModal) || shown(failureModal)) return;
          if (shown(pauseMenuModal)) {
            pauseMenuModal!.style.display = 'none';
            engine.resumeGame();
          } else {
            engine.pauseGame();
            if (pauseMenuModal) pauseMenuModal.style.display = 'flex';
          }
          return;
        }
        if (key === '`' || key === '~') {
          if (debugPanel) debugPanel.style.display = debugPanel.style.display === 'none' ? 'block' : 'none';
          return;
        }
        if (key === 'h') return toggleHelp();
        if (key === 'f') return toggleFullscreen();

        const dir = KEY_DIRS[key];
        if (dir) {
          e.preventDefault(); // keep arrow keys from scrolling a host page (e.g. itch.io)
          tryMove(dir);
        } else if (key === 'e' || key === ' ') {
          e.preventDefault();
          openTerminal();
        }
      });

      // ---- Mouse / touch on the board: swipe, or tap a square to step toward it ----
      let press: { x: number; y: number; id: number } | null = null;
      boardArea?.addEventListener('pointerdown', (e) => {
        if (e.target !== canvas) return; // ignore taps on the toast / rotate hint
        press = { x: e.clientX, y: e.clientY, id: e.pointerId };
        try { boardArea.setPointerCapture(e.pointerId); } catch {}
      });
      boardArea?.addEventListener('pointercancel', () => (press = null));
      boardArea?.addEventListener('pointerup', (e) => {
        if (!press || press.id !== e.pointerId) return;
        const dx = e.clientX - press.x;
        const dy = e.clientY - press.y;
        press = null;
        if (Math.max(Math.abs(dx), Math.abs(dy)) > 24) {
          tryMove(Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? 'RIGHT' : 'LEFT') : dy > 0 ? 'DOWN' : 'UP');
          return;
        }
        const cell = renderer.cellAt(e.clientX, e.clientY);
        if (!cell) return;
        const dr = cell.r - engine.player.r;
        const dc = cell.c - engine.player.c;
        if (dr === 0 && dc === 0) return;
        tryMove(Math.abs(dc) >= Math.abs(dr) ? (dc > 0 ? 'RIGHT' : 'LEFT') : dr > 0 ? 'DOWN' : 'UP');
      });

      // ---- On-screen D-pad: hold a direction to keep walking ----
      let repeatTimer: number | null = null;
      const stopRepeat = () => {
        if (repeatTimer !== null) clearTimeout(repeatTimer);
        repeatTimer = null;
      };
      document.querySelectorAll<HTMLElement>('.dpad-btn[data-dir]').forEach((btn) => {
        const dir = btn.dataset.dir as Dir;
        btn.addEventListener('pointerdown', (e) => {
          e.preventDefault();
          try { btn.setPointerCapture(e.pointerId); } catch {}
          stopRepeat();
          tryMove(dir);
          const again = (delay: number) => {
            repeatTimer = window.setTimeout(() => {
              tryMove(dir);
              again(140);
            }, delay);
          };
          again(280);
        });
        ['pointerup', 'pointercancel', 'lostpointercapture'].forEach((ev) => btn.addEventListener(ev, stopRepeat));
        btn.addEventListener('contextmenu', (e) => e.preventDefault());
      });
      dpadAction?.addEventListener('click', openTerminal);

      // A touch on a device that didn't report a coarse pointer still gets the D-pad.
      window.addEventListener(
        'touchstart',
        () => {
          if (!isTouch()) {
            document.documentElement.classList.add('touch');
            updateUI(engine);
          }
        },
        { once: true, passive: true }
      );

      // ---- Portrait hint for wide mazes on phones ----
      try {
        if (sessionStorage.getItem('qm_rotate_dismissed')) rotateHint?.remove();
      } catch (e) {}
      rotateHint?.addEventListener('click', () => {
        rotateHint.remove();
        try { sessionStorage.setItem('qm_rotate_dismissed', '1'); } catch (e) {}
      });

      // Render loop
      const start = performance.now();
      function loop(now: number) {
        renderer.render(
          engine.currentLevel.rows,
          engine.currentLevel.cols,
          engine.walls,
          engine.player,
          engine.checkpoints,
          engine.terminals,
          engine.doors,
          engine.quantumObjects,
          engine.energyCells,
          engine.currentLevel.exitPosition,
          engine.exitUnlocked,
          engine.exitProbability,
          engine.stateInfo,
          (now - start) / 1000
        );
        requestAnimationFrame(loop);
      }
      requestAnimationFrame(loop);

      await engine.startLevel(levelId);
      buildGateRow();
      updateUI(engine);

      // Exposed for the in-browser debug console (backtick panel) and tests.
      (window as any).qmEngine = engine;
      (window as any).qmRenderer = renderer;
    });
  </script>
</body>
</html>
