---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';
import '../styles/panels.css';
import '../styles/hud.css';
import '../styles/animations.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QUANTUM LAB | Circuit Sandbox</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
  <Navbar activePage="lab" />

  <main class="lab-container">
    <div class="lab-header">
      <span class="quantum-badge badge-cyan">CIRCUIT SANDBOX</span>
      <h1>Quantum Lab</h1>
      <p class="lab-intro">
        Build a circuit from H, X, Y, Z, S, T and CNOT gates and watch the statevector update as you go.
        Click any gate in the circuit to remove it.
      </p>
      <span class="lab-engine" id="labEngine">Engine: in-browser simulator</span>
    </div>

    <div class="lab-grid">
      <!-- Circuit builder -->
      <section class="glass-panel lab-panel" aria-label="Circuit builder">
        <div class="panel-header">
          <span class="panel-title">Circuit Builder</span>
          <div class="lab-row">
            <label class="hud-label" for="selectNumQubits">Qubits</label>
            <select id="selectNumQubits" class="lab-select">
              <option value="1">1</option>
              <option value="2" selected>2</option>
              <option value="3">3</option>
              <option value="4">4</option>
            </select>
            <button id="btnUndo" class="lab-btn" type="button">Undo</button>
            <button id="btnClearCircuit" class="lab-btn" type="button">Clear</button>
          </div>
        </div>

        <div class="lab-toolbox" role="group" aria-label="Choose a gate">
          <button class="lab-gate" type="button" data-gate="H" aria-pressed="true">H</button>
          <button class="lab-gate" type="button" data-gate="X" aria-pressed="false">X</button>
          <button class="lab-gate" type="button" data-gate="Y" aria-pressed="false">Y</button>
          <button class="lab-gate" type="button" data-gate="Z" aria-pressed="false">Z</button>
          <button class="lab-gate" type="button" data-gate="S" aria-pressed="false">S</button>
          <button class="lab-gate" type="button" data-gate="T" aria-pressed="false">T</button>
          <button class="lab-gate lab-gate-wide" type="button" data-gate="CNOT" aria-pressed="false">CNOT</button>
        </div>
        <p class="lab-gate-info" id="labGateInfo"></p>

        <div class="lab-place">
          <label class="lab-field" id="toolControlField" hidden>
            <span>Control</span>
            <select id="toolControlQubit" class="lab-select"></select>
          </label>
          <label class="lab-field">
            <span id="toolTargetLabel">Qubit</span>
            <select id="toolTargetQubit" class="lab-select"></select>
          </label>
          <button id="btnAddGateToCircuit" class="btn-quantum lab-add" type="button">Add gate</button>
        </div>
        <p class="lab-msg" id="labMsg" role="status" aria-live="polite"></p>

        <div class="lab-circuit-scroll">
          <div class="lab-circuit" id="labCircuitWires"></div>
        </div>

        <details class="lab-text-circuit">
          <summary>Text diagram</summary>
          <pre class="ascii-circuit" id="labAsciiDisplay"></pre>
        </details>
      </section>

      <!-- Statevector -->
      <section class="glass-panel lab-panel" aria-label="Statevector">
        <div class="panel-header">
          <span class="panel-title">Statevector</span>
          <span class="quantum-badge badge-emerald" id="labPurityBadge">Product state</span>
        </div>

        <span class="hud-label lab-label">State |ψ⟩</span>
        <div class="dirac-formula" id="labDiracDisplay">|00⟩</div>

        <span class="hud-label lab-label">Per-qubit P(|1⟩)</span>
        <div class="lab-qubits" id="labQubitSummary"></div>

        <span class="hud-label lab-label">Basis states: probability and phase</span>
        <div class="lab-bars" id="labBasisStateBars"></div>

        <div class="lab-presets">
          <span class="hud-label lab-label">Presets</span>
          <div class="lab-row lab-wrap">
            <button class="lab-btn preset-btn" type="button" data-preset="superposition">Superposition</button>
            <button class="lab-btn preset-btn" type="button" data-preset="bell">Bell pair</button>
            <button class="lab-btn preset-btn" type="button" data-preset="ghz">GHZ (3 qubits)</button>
            <button class="lab-btn preset-btn" type="button" data-preset="interference">H-Z-H interference</button>
            <button class="lab-btn preset-btn" type="button" data-preset="phase">S·S = Z</button>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script>
    import { quantumClient } from '../lib/api/quantumClient';
    import { QuantumSim } from '../lib/game/quantumSim';
    import type { StateInfo } from '../lib/types';

    type LabGate = { gate: string; target: number; control?: number };

    const GATE_INFO: Record<string, string> = {
      H: 'Hadamard: turns |0⟩ into an equal superposition of |0⟩ and |1⟩.',
      X: 'Pauli-X: the quantum NOT gate, swaps |0⟩ and |1⟩.',
      Y: 'Pauli-Y: a bit flip combined with a phase flip.',
      Z: 'Pauli-Z: flips the phase of |1⟩ by 180°. Probabilities stay the same.',
      S: 'S: adds a 90° phase to |1⟩. Two S gates make a Z.',
      T: 'T: adds a 45° phase to |1⟩. Two T gates make an S.',
      CNOT: 'CNOT: flips the target when the control is |1⟩. Use it after H to entangle qubits.',
    };

    const PRESETS: Record<string, { n: number; gates: LabGate[] }> = {
      superposition: { n: 1, gates: [{ gate: 'H', target: 0 }] },
      bell: { n: 2, gates: [{ gate: 'H', target: 0 }, { gate: 'CNOT', control: 0, target: 1 }] },
      ghz: {
        n: 3,
        gates: [
          { gate: 'H', target: 0 },
          { gate: 'CNOT', control: 0, target: 1 },
          { gate: 'CNOT', control: 1, target: 2 },
        ],
      },
      interference: { n: 1, gates: [{ gate: 'H', target: 0 }, { gate: 'Z', target: 0 }, { gate: 'H', target: 0 }] },
      phase: { n: 1, gates: [{ gate: 'H', target: 0 }, { gate: 'S', target: 0 }, { gate: 'S', target: 0 }] },
    };

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    function init() {
      let numQubits = 2;
      let gates: LabGate[] = [];
      let selected = 'H';
      let useBackend = false;
      let runId = 0;

      const selectNumQubits = $<HTMLSelectElement>('selectNumQubits');
      const targetSel = $<HTMLSelectElement>('toolTargetQubit');
      const controlSel = $<HTMLSelectElement>('toolControlQubit');
      const controlField = $('toolControlField');
      const targetLabel = $('toolTargetLabel');
      const gateInfo = $('labGateInfo');
      const msg = $('labMsg');
      const wires = $('labCircuitWires');
      const ascii = $('labAsciiDisplay');
      const dirac = $('labDiracDisplay');
      const bars = $('labBasisStateBars');
      const qubitSummary = $('labQubitSummary');
      const purityBadge = $('labPurityBadge');
      const engine = $('labEngine');

      function say(text: string, isError = false) {
        msg.textContent = text;
        msg.classList.toggle('is-error', isError);
      }

      function fillQubitSelects() {
        const keepT = targetSel.value;
        const keepC = controlSel.value;
        const opts = Array.from({ length: numQubits }, (_, i) => `<option value="${i}">q${i}</option>`).join('');
        targetSel.innerHTML = opts;
        controlSel.innerHTML = opts;
        if (keepT !== '' && +keepT < numQubits) targetSel.value = keepT;
        if (keepC !== '' && +keepC < numQubits) controlSel.value = keepC;
        // Sensible CNOT default: control q0, target q1.
        if (selected === 'CNOT' && targetSel.value === controlSel.value && numQubits > 1) {
          targetSel.value = String((+controlSel.value + 1) % numQubits);
        }
      }

      function selectGate(name: string) {
        selected = name;
        document.querySelectorAll<HTMLButtonElement>('.lab-gate').forEach((b) => {
          b.setAttribute('aria-pressed', String(b.dataset.gate === name));
        });
        const isCnot = name === 'CNOT';
        controlField.hidden = !isCnot;
        targetLabel.textContent = isCnot ? 'Target' : 'Qubit';
        gateInfo.textContent = GATE_INFO[name] || '';
        fillQubitSelects();
        say(isCnot && numQubits < 2 ? 'CNOT needs at least 2 qubits.' : '');
      }

      function simulateLocally(): { info: StateInfo; ascii: string } {
        const sim = new QuantumSim(numQubits);
        const entries = gates.map((g) => sim.gate(g.gate, g.target, g.control ?? null));
        return { info: sim.stateInfo(), ascii: sim.asciiDiagram(entries) };
      }

      function renderCircuit() {
        const steps = gates.length;
        wires.style.setProperty('--steps', String(Math.max(steps, 1)));
        let html = '';
        for (let q = 0; q < numQubits; q++) {
          html += `<div class="lc-label" style="grid-row:${q + 1}">q${q} <span>|0⟩</span></div>`;
          for (let s = 0; s < Math.max(steps, 1); s++) {
            const g = gates[s];
            let inner = '';
            let link = '';
            if (g) {
              if (g.gate === 'CNOT') {
                const lo = Math.min(g.control!, g.target);
                const hi = Math.max(g.control!, g.target);
                if (q === g.control) inner = '<span class="lc-ctrl"></span>';
                else if (q === g.target) inner = '<span class="lc-targ"></span>';
                if (q >= lo && q <= hi) link = q === lo ? 'lc-link-down' : q === hi ? 'lc-link-up' : 'lc-link-full';
              } else if (q === g.target) {
                inner = `<span class="lc-box">${g.gate}</span>`;
              }
            }
            const clickable = g && inner ? ` data-step="${s}" role="button" tabindex="0" title="Step ${s + 1}: ${describe(g)}. Click to remove."` : '';
            html += `<div class="lc-cell ${link}${g ? ` lc-step-${s}` : ''}" style="grid-row:${q + 1};grid-column:${s + 2}"${clickable}>${inner}</div>`;
          }
        }
        if (!steps) {
          html += `<div class="lc-empty" style="grid-row:1/${numQubits + 1}">Pick a gate and press Add gate</div>`;
        }
        wires.innerHTML = html;
      }

      function describe(g: LabGate) {
        return g.gate === 'CNOT' ? `CNOT, control q${g.control}, target q${g.target}` : `${g.gate} on q${g.target}`;
      }

      function renderState(info: StateInfo, asciiText: string) {
        ascii.textContent = asciiText;
        dirac.textContent = info.dirac_notation;

        const entangled = info.qubit_probabilities.some((qp) => qp.is_entangled);
        purityBadge.textContent = entangled ? 'Entangled' : 'Product state';
        purityBadge.className = `quantum-badge ${entangled ? 'badge-cyan' : 'badge-emerald'}`;

        qubitSummary.innerHTML = info.qubit_probabilities
          .map((qp) => {
            const p1 = Math.round(qp.p1 * 1000) / 10;
            return `<div class="lq">
              <span class="lq-name">q${qp.qubit}</span>
              <div class="lq-track"><div class="lq-fill" style="width:${p1}%"></div></div>
              <span class="lq-val">${p1.toFixed(1)}%</span>
              ${qp.is_entangled ? '<span class="lq-tag">entangled</span>' : ''}
            </div>`;
          })
          .join('');

        bars.innerHTML = info.basis_states
          .map((bs) => {
            const pct = bs.probability * 100;
            const zero = bs.probability < 1e-6;
            const amp = zero ? '0' : formatAmp(bs.amplitude_real, bs.amplitude_imag);
            return `<div class="lb${zero ? ' is-zero' : ''}">
              <span class="lb-ket">|${bs.binary}⟩</span>
              <div class="lb-track"><div class="lb-fill" style="width:${pct}%"></div></div>
              <span class="lb-pct">${pct.toFixed(1)}%</span>
              <span class="lb-amp" title="Amplitude">${amp}</span>
              <span class="lb-phase" title="Phase">${zero ? '–' : `${Math.round(bs.phase_degrees) % 360}°`}</span>
            </div>`;
          })
          .join('');
      }

      function formatAmp(re: number, im: number) {
        const r = Math.abs(re) < 1e-4 ? 0 : re;
        const i = Math.abs(im) < 1e-4 ? 0 : im;
        if (!i) return r.toFixed(3);
        if (!r) return `${i.toFixed(3)}i`;
        return `${r.toFixed(3)}${i >= 0 ? '+' : '−'}${Math.abs(i).toFixed(3)}i`;
      }

      async function run() {
        const id = ++runId;
        renderCircuit();
        const local = simulateLocally();
        renderState(local.info, local.ascii);

        if (!useBackend) return;
        try {
          const res = await quantumClient.executeArbitraryCircuit(numQubits, gates);
          if (id === runId) renderState(res.state_info, res.ascii_diagram);
        } catch {
          // Backend went away: the local result is already on screen.
          useBackend = false;
          engine.textContent = 'Engine: in-browser simulator';
        }
      }

      function setQubits(n: number) {
        numQubits = n;
        selectNumQubits.value = String(n);
        fillQubitSelects();
      }

      // --- events ---
      document.querySelectorAll<HTMLButtonElement>('.lab-gate').forEach((btn) => {
        btn.addEventListener('click', () => selectGate(btn.dataset.gate || 'H'));
      });

      $('btnAddGateToCircuit').addEventListener('click', () => {
        const target = parseInt(targetSel.value, 10);
        if (selected === 'CNOT') {
          if (numQubits < 2) return say('CNOT needs at least 2 qubits. Raise the qubit count first.', true);
          const control = parseInt(controlSel.value, 10);
          if (control === target) return say('Control and target must be different qubits.', true);
          gates.push({ gate: 'CNOT', control, target });
        } else {
          gates.push({ gate: selected, target });
        }
        say(`Added ${describe(gates[gates.length - 1])}.`);
        run();
      });

      wires.addEventListener('click', (e) => {
        const cell = (e.target as HTMLElement).closest<HTMLElement>('[data-step]');
        if (!cell) return;
        const step = parseInt(cell.dataset.step || '-1', 10);
        const [removed] = gates.splice(step, 1);
        if (removed) say(`Removed ${describe(removed)}.`);
        run();
      });
      wires.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          const cell = (e.target as HTMLElement).closest<HTMLElement>('[data-step]');
          if (cell) {
            e.preventDefault();
            cell.click();
          }
        }
      });
      wires.addEventListener('mouseover', (e) => {
        const cell = (e.target as HTMLElement).closest<HTMLElement>('[data-step]');
        wires.querySelectorAll('.is-hover').forEach((c) => c.classList.remove('is-hover'));
        if (cell) wires.querySelectorAll(`.lc-step-${cell.dataset.step}`).forEach((c) => c.classList.add('is-hover'));
      });
      wires.addEventListener('mouseleave', () => {
        wires.querySelectorAll('.is-hover').forEach((c) => c.classList.remove('is-hover'));
      });

      $('btnUndo').addEventListener('click', () => {
        const removed = gates.pop();
        say(removed ? `Removed ${describe(removed)}.` : 'Nothing to undo.');
        run();
      });

      $('btnClearCircuit').addEventListener('click', () => {
        gates = [];
        say('Circuit cleared.');
        run();
      });

      selectNumQubits.addEventListener('change', () => {
        const n = parseInt(selectNumQubits.value, 10);
        const before = gates.length;
        gates = gates.filter((g) => g.target < n && (g.control === undefined || g.control < n));
        setQubits(n);
        if (selected === 'CNOT') selectGate('CNOT');
        say(before !== gates.length ? 'Removed gates that used qubits no longer in the circuit.' : '');
        run();
      });

      document.querySelectorAll<HTMLButtonElement>('.preset-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const p = PRESETS[btn.dataset.preset || ''];
          if (!p) return;
          setQubits(p.n);
          gates = p.gates.map((g) => ({ ...g }));
          say(`Loaded preset: ${btn.textContent?.trim()}.`);
          run();
        });
      });

      selectGate('H');
      // Deep link: /lab?preset=bell opens with that circuit loaded.
      const start = PRESETS[new URLSearchParams(location.search).get('preset') || ''];
      if (start) {
        setQubits(start.n);
        gates = start.gates.map((g) => ({ ...g }));
      }
      run();

      // Use the Qiskit backend only when one is configured and answers quickly.
      quantumClient.isBackendAvailable().then((ok) => {
        if (!ok) return;
        useBackend = true;
        engine.textContent = 'Engine: Qiskit backend';
        run();
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  </script>

  <style is:global>
    .lab-container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 30px 16px 60px;
    }

    .lab-header {
      text-align: center;
      margin-bottom: 26px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    .lab-header h1 { font-size: clamp(24px, 4vw, 32px); margin: 0; }
    .lab-intro { color: var(--muted); font-size: 14px; max-width: 640px; margin: 0; line-height: 1.6; }
    .lab-engine { font-family: var(--font-mono); font-size: 11px; color: var(--muted); }

    .lab-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 20px;
      align-items: start;
    }
    .lab-panel { padding: 20px; min-width: 0; }
    .lab-label { display: block; margin: 16px 0 6px; }

    .lab-row { display: flex; align-items: center; gap: 8px; }
    .lab-wrap { flex-wrap: wrap; }

    .lab-select, .lab-btn {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text);
      background: var(--panel-2, var(--bg));
      border: 2px solid var(--border);
      border-radius: 4px;
      padding: 6px 10px;
      cursor: pointer;
    }
    .lab-btn:hover, .lab-select:hover { border-color: var(--accent); }
    .lab-btn:focus-visible, .lab-select:focus-visible, .lab-gate:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    .lab-toolbox { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
    .lab-gate {
      min-width: 44px;
      height: 44px;
      padding: 0 10px;
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 16px;
      color: var(--text);
      background: var(--bg);
      border: 2px solid var(--border);
      border-radius: 4px;
      cursor: pointer;
    }
    .lab-gate-wide { font-size: 13px; }
    .lab-gate:hover { border-color: var(--accent); }
    .lab-gate[aria-pressed='true'] { background: var(--accent); color: var(--accent-ink); border-color: var(--text); }

    .lab-gate-info { min-height: 1.4em; margin: 10px 0 0; color: var(--muted); font-size: 13px; line-height: 1.5; }

    .lab-place {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 12px;
      margin-top: 12px;
      padding: 12px;
      background: var(--bg);
      border: 2px solid var(--border);
      border-radius: 4px;
    }
    .lab-field { display: flex; flex-direction: column; gap: 4px; font-family: var(--font-mono); font-size: 11px; color: var(--muted); }
    .lab-field[hidden] { display: none; }
    .lab-add { margin-left: auto; padding: 8px 16px; font-size: 12px; }

    .lab-msg { min-height: 1.4em; margin: 8px 0 0; font-family: var(--font-mono); font-size: 12px; color: var(--ok); }
    .lab-msg.is-error { color: var(--danger); }

    /* Circuit diagram */
    .lab-circuit-scroll {
      margin-top: 12px;
      overflow-x: auto;
      padding: 12px 8px;
      background: var(--bg);
      border: 2px solid var(--border);
      border-radius: 4px;
    }
    .lab-circuit {
      --cell: 48px;
      display: grid;
      grid-template-columns: 64px repeat(var(--steps), var(--cell)) 24px;
      grid-auto-rows: var(--cell);
      position: relative;
      min-width: max-content;
      font-family: var(--font-mono);
    }
    .lc-label {
      grid-column: 1;
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 700;
      color: var(--accent);
    }
    .lc-label span { color: var(--muted); font-weight: 400; font-size: 11px; }
    .lc-cell {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    /* the qubit wire */
    .lc-cell::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      height: 2px;
      background: var(--border-strong);
    }
    /* CNOT vertical connector */
    .lc-link-down::after, .lc-link-up::after, .lc-link-full::after {
      content: '';
      position: absolute;
      left: calc(50% - 1px);
      width: 2px;
      background: var(--accent);
    }
    .lc-link-down::after { top: 50%; bottom: 0; }
    .lc-link-up::after { top: 0; bottom: 50%; }
    .lc-link-full::after { top: 0; bottom: 0; }

    .lc-box, .lc-ctrl, .lc-targ { position: relative; z-index: 1; }
    .lc-box {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      background: var(--panel);
      border: 2px solid var(--accent);
      border-radius: 4px;
      color: var(--text);
      font-weight: 700;
      font-size: 14px;
    }
    .lc-ctrl { width: 12px; height: 12px; border-radius: 50%; background: var(--accent); }
    .lc-targ {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      border: 2px solid var(--accent);
      background:
        linear-gradient(var(--accent), var(--accent)) center / 2px 100% no-repeat,
        linear-gradient(var(--accent), var(--accent)) center / 100% 2px no-repeat,
        var(--bg);
    }
    .lc-cell[data-step] { cursor: pointer; }
    .lc-cell.is-hover .lc-box { border-color: var(--danger); color: var(--danger); }
    .lc-cell.is-hover .lc-ctrl { background: var(--danger); }
    .lc-cell.is-hover .lc-targ {
      border-color: var(--danger);
      background:
        linear-gradient(var(--danger), var(--danger)) center / 2px 100% no-repeat,
        linear-gradient(var(--danger), var(--danger)) center / 100% 2px no-repeat,
        var(--bg);
    }
    .lc-cell.is-hover::after { background: var(--danger); }
    .lc-cell[data-step]:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
    .lc-empty {
      grid-column: 2 / -1;
      align-self: center;
      justify-self: start;
      position: relative;
      z-index: 1;
      margin-left: 12px;
      padding: 2px 8px;
      background: var(--bg);
      color: var(--muted);
      font-size: 12px;
      white-space: nowrap;
    }

    .lab-text-circuit { margin-top: 12px; }
    .lab-text-circuit summary { cursor: pointer; font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
    .lab-text-circuit pre { margin-top: 8px; overflow-x: auto; }

    /* State panel */
    #labDiracDisplay { word-break: break-word; }

    .lab-qubits { display: flex; flex-direction: column; gap: 6px; }
    .lq { display: grid; grid-template-columns: 30px 1fr 54px auto; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 12px; }
    .lq-name { color: var(--accent); font-weight: 700; }
    .lq-track, .lb-track { height: 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 2px; overflow: hidden; }
    .lq-fill, .lb-fill { height: 100%; background: var(--accent); transition: width 0.2s ease; }
    .lq-val { text-align: right; color: var(--text); }
    .lq-tag { font-size: 10px; color: var(--accent-2, var(--accent)); border: 1px solid currentColor; border-radius: 3px; padding: 1px 5px; }

    .lab-bars { display: flex; flex-direction: column; gap: 6px; }
    .lb {
      display: grid;
      grid-template-columns: 58px minmax(40px, 1fr) 52px 98px 38px;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: 12px;
    }
    .lb.is-zero { opacity: 0.45; }
    .lb-ket { color: var(--accent); font-weight: 700; }
    .lb-pct { text-align: right; color: var(--text); }
    .lb-amp { text-align: right; color: var(--muted); white-space: nowrap; }
    .lb-phase { text-align: right; color: var(--muted); }

    .lab-presets { margin-top: 20px; border-top: 2px solid var(--border); padding-top: 4px; }

    @media (max-width: 900px) {
      .lab-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 480px) {
      .lab-panel { padding: 14px; }
      .lab-add { margin-left: 0; width: 100%; }
      .lb { grid-template-columns: 52px minmax(30px, 1fr) 48px 38px; }
      .lb-amp { display: none; }
    }
  </style>
</body>
